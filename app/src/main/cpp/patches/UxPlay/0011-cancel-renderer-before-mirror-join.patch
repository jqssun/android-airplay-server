diff --git a/lib/raop_rtp_mirror.c b/lib/raop_rtp_mirror.c
--- a/lib/raop_rtp_mirror.c
+++ b/lib/raop_rtp_mirror.c
@@ -946,6 +946,12 @@
     raop_rtp_mirror->running = 0;
     MUTEX_UNLOCK(raop_rtp_mirror->run_mutex);
 
+    /* The frame callback may be waiting for decoder capacity. Cancel that wait
+     * before joining its thread; the final running=false notification is later. */
+    if (raop_rtp_mirror->callbacks.mirror_video_stopping) {
+        raop_rtp_mirror->callbacks.mirror_video_stopping(raop_rtp_mirror->callbacks.cls);
+    }
+
     /* Join the thread */
     THREAD_JOIN(raop_rtp_mirror->thread_mirror);
 
