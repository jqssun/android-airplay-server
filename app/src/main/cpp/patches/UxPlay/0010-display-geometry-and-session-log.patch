-    plist_t displays_0_uuid_node = plist_new_string("e0ff8a27-6738-3d56-8a16-cc53aacee925");
+    plist_t displays_0_width_physical_node = plist_new_uint(raop->displayPhysicalWidth);
+    plist_t displays_0_height_physical_node = plist_new_uint(raop->displayPhysicalHeight);
+    /* the sender identifies the extended desktop by this id, so it has to be
+       unique per receiver: derive it from the hardware address */
+    char display_uuid[40];
+    raop_display_uuid(display_uuid, sizeof(display_uuid), hw_addr_raw, hw_addr_raw_len);
+    plist_t displays_0_uuid_node = plist_new_string(display_uuid);
     plist_t displays_0_width_node = plist_new_uint(raop->width);
