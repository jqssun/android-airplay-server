diff --git a/lib/raop_handlers.h b/lib/raop_handlers.h
index b3f3b17..148c4d8 100644
--- a/lib/raop_handlers.h
+++ b/lib/raop_handlers.h
@@ -32,6 +32,23 @@
 typedef void (*raop_handler_t)(raop_conn_t *, http_request_t *,
                                http_response_t *, char **, int *);
 
+/* build a stable per-device display uuid from the hardware address: the
+   sender uses it to identify the extended desktop, a fixed uuid would be
+   claimed by every receiver */
+static void
+raop_display_uuid(char *buf, size_t len, const char *hw_addr, int hw_addr_len)
+{
+    unsigned char b[16] = { 0 };
+    int n = (hw_addr_len < (int) sizeof(b)) ? hw_addr_len : (int) sizeof(b);
+    for (int i = 0; i < n; i++) {
+        b[i] = (unsigned char) hw_addr[i];
+    }
+    snprintf(buf, len,
+             "%02x%02x%02x%02x-%02x%02x-%02x%02x-%02x%02x-%02x%02x%02x%02x%02x%02x",
+             b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7],
+             b[8], b[9], b[10], b[11], b[12], b[13], b[14], b[15]);
+}
+
 
 static void
 raop_handler_info(raop_conn_t *conn,
@@ -214,9 +231,13 @@ raop_handler_info(raop_conn_t *conn,
 
