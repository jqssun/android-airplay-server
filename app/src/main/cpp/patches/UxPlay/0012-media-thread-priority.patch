 #define sleepms(x) usleep((x)*1000)
 
@@ -32,6 +33,12 @@ typedef pthread_t thread_handle_t;
 	if (pthread_create(&(handle), NULL, func, arg)) handle = 0
 #define THREAD_JOIN(handle) pthread_join(handle, NULL)
 
+/* Best effort: a media thread that is starved by the ui thread stalls the
+   stream, so ask to run ahead of it.  Raising the priority can be refused
+   (the caller may not be allowed to), which is not an error worth reporting. */
+#define THREAD_RAISE_PRIORITY() \
+	do { setpriority(PRIO_PROCESS, (int) gettid(), -5); } while (0)
+
 typedef pthread_mutex_t mutex_handle_t;
 
 typedef pthread_cond_t cond_handle_t;
