@@ -67,8 +67,13 @@ http_handler_server_info(raop_conn_t *conn, http_request_t *request, http_respon
      * bit 42 is the hevc capability ("ScreenMultiCodec"): it tells the sender
      * that the receiver can take a picture above 1080p. the hardcoded value
      * above never carried it, so the sender did not know.
+     *
+     * the value is the app's choice: the dns-sd record advertises the full
+     * feature set (0x5A7FFEE6), and a sender that reads this plist instead
+     * would see a receiver that is much less capable than the one the
+     * dns-sd record describes.
      */
-    uint64_t features = 0x27F;
+    uint64_t features = raop->infoFeatures;
     if (dnssd_get_airplay_features(raop->dnssd) & (1ULL << 42)) {
         features |= (1ULL << 42);
     }
