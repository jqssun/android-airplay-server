+/* the model name in the txt records: the sender reads it together with the
+ * feature bits to pick the codec and the bitrate budget it uses */
+void
+dnssd_set_receiver_model(dnssd_t *dnssd, const char *model)
+{
+    if (!dnssd || !model) {
+        return;
+    }
+    if (dnssd->model) {
+        free(dnssd->model);
+    }
+    dnssd->model = strdup(model);
+}
