diff --git a/lib/raop.c b/lib/raop.c
index dee4e8f..79ab46d 100644
--- a/lib/raop.c
+++ b/lib/raop.c
@@ -77,6 +77,14 @@ struct raop_s {
     uint32_t displayPhysicalWidth;
     uint32_t displayPhysicalHeight;
 
+    /* the identity the receiver tells the sender about. the model name and
+       the feature bits are what the sender reads to decide which codec it
+       may use and how many bits it spends on the picture, so they are
+       configurable instead of hardcoded. */
+    char receiverModel[32];
+    uint32_t displayFeatures;
+    uint32_t infoFeatures;
+
     int audio_delay_micros;
 
      /* for temporary storage of pin during pair-pin start */
@@ -634,6 +642,13 @@ raop_init(raop_callbacks_t *callbacks) {
     raop->maxFPS = 30;
     raop->overscanned = 0;
 
+    /* the identity the sender is told about: an old apple tv by default,
+       the app can ask for a modern one to get hevc and a bigger bitrate
+       budget out of the sender */
+    snprintf(raop->receiverModel, sizeof(raop->receiverModel), "%s", GLOBAL_MODEL);
+    raop->displayFeatures = 14;
+    raop->infoFeatures = 0x27F;
+
     /* initialise stored pin */
     raop->pin = 0;
     raop->use_pin = false;
@@ -792,12 +807,27 @@ int raop_set_plist(raop_t *raop, const char *plist_item, const int value) {
         } else {
             raop->displayPhysicalHeight = (uint32_t) value;
         }
+    } else if (strcmp(plist_item, "displayFeatures") == 0) {
+        /* the feature bits of the display entry of the info response */
+        raop->displayFeatures = (uint32_t) value;
+    } else if (strcmp(plist_item, "infoFeatures") == 0) {
+        /* the feature bits of the info response */
+        raop->infoFeatures = (uint32_t) value;
     } else {
         retval = -1;
     }	  
     return retval;
 }
 
+/* the model name the receiver tells the sender about: the sender reads it
+ * together with the feature bits to pick the codec and the bitrate budget */
+void raop_set_receiver_model(raop_t *raop, const char *model) {
+    if (!raop || !model) {
+        return;
+    }
+    snprintf(raop->receiverModel, sizeof(raop->receiverModel), "%s", model);
+}
